{
  "name": "relay-extension",
  "version": "2.0.0",
  "description": "Relay — AI Context Bridge Browser Extension. Lossless local archive for AI conversations and full-fidelity cross-platform handoff.",
  "scripts": {
    "build": "node build-icons.js",
    "pack": "node build-package.js",
    "pack:chrome": "node build-package.js --target=chrome",
    "pack:firefox": "node build-package.js --target=firefox",
    "pack:source": "node build-package.js --target=source",
    "dev": "echo 'Load this folder as unpacked extension in browser'",
    "lint": "node scripts/lint.js",
    "lint:fix": "node scripts/lint.js",
    "test": "node --test tests/unit/",
    "test:unit": "node --test tests/unit/",
    "test:e2e": "node tests/e2e/test.js",
    "validate": "npm run lint && npm run test:unit"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.2",
    "puppeteer": "^24.43.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "license": "MIT",
  "allowScripts": {
    "puppeteer@24.43.1": true,
    "sharp@0.33.5": true
  }
}
